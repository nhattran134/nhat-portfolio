---
import Kit from '../../layouts/Kit.astro';
import Article from '../../components/Article.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Kit title="Blog: CI/CD and release notes by Nhat Tran" description="Posts on CI/CD pipelines, Terraform, cloud infrastructure and release management.">
  <Article back={{ href: '/', label: 'Home' }} title="Posts on pipelines and releases">
    <ul class="rows">
      {posts.map((post) => (
        <li><a class="rows__name link" href={`/blog/${post.id}`}>{post.data.title}</a><p>{post.data.excerpt}</p><span class="rows__value">{fmt(post.data.date)}</span></li>
      ))}
    </ul>
  </Article>
</Kit>
