---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { byDate } from '../../data/content';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort(byDate);
---

<Base title="Notes | Nathan Tran" description="Notes on CI/CD pipelines, release management, cloud infrastructure and AI agent platforms.">
  <PageHead n="4" title="Notes" back={{ href: '/#notes', label: 'Home' }}>
    <p>Write-ups from the work: pipeline patterns, release practice and AI agent platforms.</p>
  </PageHead>
  <section class="sheet">
    <div class="wrap">
      <div class="sheet-head">
        <h2 class="h3"><span class="num">4.1–4.{posts.length}</span> All notes</h2>
        <span>Newest first</span>
      </div>
      <PostList posts={posts} level={3} />
    </div>
  </section>
</Base>

<style>
  .h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0;
  }
</style>
