---
import Kit from '../../layouts/Kit.astro';
import Article from '../../components/Article.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Date(entry.data.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Kit title={`${entry.data.title}: Nathan Tran's blog`} description={entry.data.excerpt}>
  <Article back={{ href: '/blog', label: 'All posts' }} title={entry.data.title} meta={date} lead={entry.data.excerpt}>
    <Content />
  </Article>
</Kit>
