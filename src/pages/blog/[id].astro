---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Article from '../../components/Article.astro';
import { getCollection, render } from 'astro:content';
import { byDate, formatDate } from '../../data/content';
import CloseBand from '../../components/CloseBand.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort(byDate);
  return posts.map((entry, i) => ({ params: { id: entry.id }, props: { entry, n: i + 1 } }));
}

const { entry, n } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} | Nathan Tran`} description={entry.data.excerpt}>
  <PageHead n={`4.${n}`} title={entry.data.title} back={{ href: '/blog', label: 'All notes' }}>
    <p>{entry.data.excerpt}</p>
  </PageHead>
  <Article specs={[
    ['Published', formatDate(entry.data.date)],
    ['Topics', entry.data.tags],
  ]}>
    <Content />
  </Article>
  <CloseBand />
</Base>
