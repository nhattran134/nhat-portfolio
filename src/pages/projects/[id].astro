---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Article from '../../components/Article.astro';
import Flow from '../../components/Flow.astro';
import { getCollection, render } from 'astro:content';
import { byDate } from '../../data/content';
import CloseBand from '../../components/CloseBand.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(byDate);
  return projects.map((entry, i) => ({ params: { id: entry.id }, props: { entry, n: i + 1 } }));
}

const { entry, n } = Astro.props;
const { Content } = await render(entry);
const steps = entry.data.flow;
---

<Base title={`${entry.data.title} | Nathan Tran`} description={entry.data.description}>
  <PageHead n={`2.${n}`} title={entry.data.title} back={{ href: '/#work', label: 'All work' }}>
    <p>{entry.data.description}</p>
  </PageHead>
  <Article specs={[['Stack', entry.data.tags]]}>
    {steps && <div slot="aside"><Flow steps={steps} label={`Figure 2.${n} · Flow`} compact /></div>}
    <Content />
  </Article>
  <CloseBand />
</Base>
