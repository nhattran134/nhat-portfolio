---
import Kit from '../../layouts/Kit.astro';
import Article from '../../components/Article.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Kit title={`${entry.data.title}: a pipeline project by Nhat Tran`} description={entry.data.description}>
  <Article back={{ href: '/#work', label: 'All pipeline projects' }} title={entry.data.title} meta={entry.data.tags.join(', ')} lead={entry.data.description}>
    <Content />
  </Article>
</Kit>
