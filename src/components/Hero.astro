---
import Icon from './Icon.astro';
import GatesFigure from './GatesFigure.astro';
import { services } from '../data/services';
import { contactNote } from '../data/contact';
---

<section id="services" class="spread" data-sec="services" aria-labelledby="hero-title">
  <div class="on-field cover">
    <div class="cap" aria-hidden="true"><span>Section 1</span><span>Services</span></div>
    <div class="foot">
      <h1 id="hero-title">I design the platforms your teams ship on.</h1>
      <p>Senior Platform Engineer &amp; Release Manager. CI/CD, cloud infrastructure, release process, and now governed AI agent platforms.</p>
    </div>
    <GatesFigure tone="field" class="gates-cover" />
  </div>

  <div class="contents guides">
    <div class="sheet-head">
      <h2><span class="num">1.0</span> Contents</h2>
      <span>What you can hire me for</span>
    </div>

    <form class="form request" name="request" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-ajax>
      <input type="hidden" name="form-name" value="request" />
      <p class="vh"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="form-cap"><span>Form 1 · Project request</span></div>
      <div class="row">
        <label class="field">Email
          <input type="email" name="email" placeholder="you@company.com" autocomplete="email" required />
        </label>
        <label class="field">What do you need?
          <select name="need" required>
            <option value="" disabled selected>Choose one</option>
            {services.map((s) => <option>{s.title}</option>)}
            <option>Job opportunity</option>
            <option>Other</option>
          </select>
        </label>
        <button class="btn" type="submit">Send <Icon name="arrow" /></button>
      </div>
      <p class="form-note">{contactNote}</p>
      <p class="form-status" role="status" hidden></p>
    </form>

    <ol class="toc">
      {services.map((s, i) => (
        <li>
          <a href={`#standard-1-${i + 1}`}>
            <span class="n num">1.{i + 1}</span>
            <span class="t">
              <span class="tt">{s.title}</span>
              {s.isNew && <span class="new">New</span>}
              <span class="lead" aria-hidden="true"></span>
              <Icon name="arrow" />
            </span>
            <span class="d">{s.summary}</span>
          </a>
        </li>
      ))}
    </ol>

    <GatesFigure tone="paper" class="gates-sheet" />

  </div>
</section>

<style>
  .spread {
    display: grid;
    grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
    min-height: calc(100svh - var(--head-h));
    max-width: var(--max);
    margin-inline: auto;
  }

  .cover {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 28px var(--gutter) 44px;
    overflow: hidden;
  }

  .cap {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 700;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--on-field-mute);
  }

  .cover :global(.gates-cover) {
    margin-top: auto;
  }

  .contents :global(.gates-sheet) {
    display: none;
  }

  .cover h1 {
    font-size: clamp(44px, 4.8vw, 76px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    max-width: 12ch;
  }

  .cover p {
    margin-top: 18px;
    font-size: 19px;
    line-height: 1.45;
    max-width: 36ch;
    color: var(--on-field-mute);
  }

  .contents {
    padding: 24px var(--gutter) 32px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .contents .sheet-head {
    background: var(--paper);
  }

  .sheet-head h2 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .toc {
    list-style: none;
  }

  /* Guides stop at the letterforms: text runs sit on paper. */
  .n,
  .tt,
  .d {
    justify-self: start;
    background: var(--paper);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .toc a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    column-gap: 12px;
    padding: 11px 0 12px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .n {
    font-weight: 700;
    font-size: 15px;
    color: var(--field);
    padding-top: 4px;
  }

  .t {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .tt {
    flex: none;
  }

  .lead {
    flex: 1;
    border-bottom: 2px dotted #b4b8c2;
    transform: translateY(-5px);
    min-width: 24px;
  }

  .t :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
    align-self: center;
    color: var(--field);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .new {
    flex: none;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--field);
    color: var(--on-field);
    padding: 3px 6px;
    align-self: center;
  }

  .d {
    grid-column: 2;
    font-size: 15px;
    color: var(--mute);
    margin-top: 2px;
  }

  .toc a:hover .tt {
    color: var(--field);
  }

  .toc a:hover :global(svg) {
    transform: translateX(4px);
  }

  .request .row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto;
  }

  .request .field + .field {
    border-left: 1px solid var(--ink);
  }

  .request .btn {
    min-height: 100%;
    border-width: 0;
    padding: 0 26px;
  }

  @media (max-width: 1100px) {
    /* Single column: keep the request form near the top; the contents list carries the same facts. */
    .cover :global(.gates-cover) {
      display: none;
    }
    .contents :global(.gates-sheet) {
      display: block;
      margin-top: 8px;
    }
    .spread {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .cover {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .t {
      font-size: 19px;
    }
    .toc a {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .request .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .request .field + .field {
      border-left: 0;
      border-top: 1px solid var(--ink);
    }
    .request .btn {
      min-height: 52px;
    }
  }
</style>
