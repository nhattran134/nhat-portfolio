---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { services } from '../data/services';
import { byDate } from '../data/content';

// Number projects the way the Work section does (newest first), so "2.4" matches.
const projects = (await getCollection('projects')).sort(byDate);
const ref = (id: string) => {
  const i = projects.findIndex((p) => p.id === id);
  if (i < 0) throw new Error(`services.ts: unknown project id "${id}"`);
  return { n: `2.${i + 1}`, title: projects[i].data.title, href: `/projects/${id}` };
};
---

<section class="sheet" aria-labelledby="standards-title">
  <div class="wrap">
    <div class="sheet-head">
      <h2 id="standards-title" class="h3"><span class="num">1.1–1.{services.length}</span> Standards</h2>
      <span>What each service holds to</span>
    </div>
    <ol class="standards">
      {services.map((s, i) => (
        <li id={`standard-1-${i + 1}`}>
          <div class="what">
            <h3><span class="num">1.{i + 1}</span> {s.title}</h3>
            {s.proof ? (
              <ul class="proof" aria-label="Proven in">
                {s.proof.map(ref).map((r) => (
                  <li><a class="link-arrow" href={r.href}><span class="num">{r.n}</span> {r.title} <Icon name="arrow" /></a></li>
                ))}
              </ul>
            ) : (
              <p>{s.desc}</p>
            )}
          </div>
          <figure class="use ok">
            <figcaption><Icon name="check" /> Correct</figcaption>
            <p>{s.correct}</p>
          </figure>
          <figure class="use no">
            <figcaption><Icon name="cross" /> Incorrect</figcaption>
            <p>{s.incorrect}</p>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .h3 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .standards {
    list-style: none;
  }

  .standards > li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 3.5fr) minmax(0, 3.5fr);
    gap: 28px;
    padding: 26px 0 28px;
    border-bottom: 1px solid var(--line);
  }

  .what h3 {
    font-size: 26px;
    font-weight: 800;
    display: flex;
    gap: 14px;
    align-items: baseline;
  }

  .what h3 .num {
    font-size: 16px;
    font-weight: 700;
    color: var(--field);
    min-width: 2.4em;
  }

  .what p {
    margin-top: 10px;
    color: var(--mute);
    max-width: 52ch;
    padding-left: calc(2.4em * 16 / 17 + 14px);
  }

  .proof {
    list-style: none;
    margin-top: 10px;
    padding-left: calc(2.4em * 16 / 17 + 14px);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .proof::before {
    content: 'Proven in';
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .proof .num {
    color: var(--mute);
    font-weight: 600;
  }

  .use {
    border-top: 4px solid currentColor;
    padding-top: 10px;
  }

  .use.ok {
    color: var(--field);
  }

  .use.no {
    color: var(--no);
  }

  .use figcaption {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .use figcaption :global(svg) {
    width: 16px;
    height: 16px;
  }

  .use p {
    margin-top: 8px;
    color: var(--ink);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .standards > li {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 18px 20px;
    }
    .what {
      grid-column: 1 / -1;
    }
    .what p,
    .proof {
      padding-left: 0;
    }
  }

  /* Phones: panels stay side by side so the seven standards take half the scroll. */
  @media (max-width: 560px) {
    .standards > li {
      gap: 14px 14px;
      padding: 22px 0 24px;
    }
    .what h3 {
      font-size: 21px;
    }
    .use p {
      font-size: 15px;
    }
  }
</style>
