---
import Icon from './Icon.astro';
import { services } from '../data/services';
---

<section class="sheet" aria-labelledby="standards-title">
  <div class="wrap">
    <div class="sheet-head">
      <h2 id="standards-title" class="h3"><span class="num">1.1–1.{services.length}</span> Standards</h2>
      <span>What each service holds to</span>
    </div>
    <ol class="standards">
      {services.map((s, i) => (
        <li id={`standard-1-${i + 1}`}>
          <div class="what">
            <h3><span class="num">1.{i + 1}</span> {s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <figure class="use ok">
            <figcaption><Icon name="check" /> Correct</figcaption>
            <p>{s.correct}</p>
          </figure>
          <figure class="use no">
            <figcaption><Icon name="cross" /> Incorrect</figcaption>
            <p>{s.incorrect}</p>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .h3 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .standards {
    list-style: none;
  }

  .standards li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 3.5fr) minmax(0, 3.5fr);
    gap: 28px;
    padding: 26px 0 28px;
    border-bottom: 1px solid var(--line);
  }

  .what h3 {
    font-size: 26px;
    font-weight: 800;
    display: flex;
    gap: 14px;
    align-items: baseline;
  }

  .what h3 .num {
    font-size: 16px;
    font-weight: 700;
    color: var(--field);
    min-width: 2.4em;
  }

  .what p {
    margin-top: 10px;
    color: var(--mute);
    max-width: 52ch;
    padding-left: calc(2.4em * 16 / 17 + 14px);
  }

  .use {
    border-top: 4px solid currentColor;
    padding-top: 10px;
  }

  .use.ok {
    color: var(--field);
  }

  .use.no {
    color: var(--no);
  }

  .use figcaption {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .use figcaption :global(svg) {
    width: 16px;
    height: 16px;
  }

  .use p {
    margin-top: 8px;
    color: var(--ink);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .standards li {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 18px 20px;
    }
    .what {
      grid-column: 1 / -1;
    }
    .what p {
      padding-left: 0;
    }
  }

  @media (max-width: 560px) {
    .standards li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
