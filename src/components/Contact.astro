---
import Icon from './Icon.astro';
import { contactNote } from '../data/contact';
---

<section id="contact" class="on-field contact" data-sec="contact" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div class="intro">
      <h2 id="contact-title"><span class="num">5</span> Contact</h2>
      <p>A pipeline that needs fixing, a cloud estate to tidy, a release process to set up, or AI agents to put behind proper controls. Tell me what you are working with.</p>
      <ul class="links">
        <li><a href="https://linkedin.com/in/nathantr" target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="arrow" /></a></li>
        <li><a href="https://github.com/nhattran134" target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" /></a></li>
      </ul>
    </div>

    <form class="form-frame" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-ajax>
      <input type="hidden" name="form-name" value="contact" />
      <p class="vh"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="form-cap"><span>Form 2 · Message</span></div>
      <div class="row">
        <label class="form-field">Name
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="form-field">Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>
      <label class="form-field rule">Subject
        <select name="subject">
          <option>Consulting</option>
          <option>Job opportunity</option>
          <option>Collaboration</option>
          <option>Other</option>
        </select>
      </label>
      <label class="form-field rule">Message
        <textarea name="message" rows="5" required></textarea>
      </label>
      <div class="send">
        <button class="button-solid" type="submit">Send message <Icon name="arrow" /></button>
      </div>
      <p class="form-note">{contactNote}</p>
      <p class="form-status" role="status" hidden></p>
    </form>
  </div>
</section>

<style>
  .contact {
    border-top: 2px solid var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px;
    padding-block: 40px 64px;
    align-items: end;
  }

  h2 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .intro p {
    margin-top: 14px;
    font-size: 1.1875rem;
    line-height: 1.45;
    max-width: 40ch;
    color: var(--on-field-mute);
  }

  .links {
    list-style: none;
    display: flex;
    gap: 28px;
    margin-top: 28px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
    border-bottom: 2px solid var(--on-field-mute);
    padding-bottom: 2px;
  }

  .links a:hover {
    border-bottom-color: var(--on-field);
  }

  .links :global(svg) {
    width: 16px;
    height: 16px;
  }

  .form-frame {
    border-color: var(--ink);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .row .form-field + .form-field {
    border-left: 1px solid var(--ink);
  }

  .rule {
    border-top: 1px solid var(--ink);
  }

  .send {
    border-top: 1px solid var(--ink);
    display: flex;
    justify-content: flex-end;
  }

  .send .button-solid {
    border-width: 0;
    background: var(--field);
    color: var(--on-field);
    min-height: 56px;
  }

  .send .button-solid:hover {
    background: var(--field-deep);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .row .form-field + .form-field {
      border-left: 0;
      border-top: 1px solid var(--ink);
    }
    .send .button-solid {
      width: 100%;
    }
  }
</style>
