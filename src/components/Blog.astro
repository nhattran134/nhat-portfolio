---
import { getCollection } from 'astro:content';
import Divider from './Divider.astro';
import PostList from './PostList.astro';
import Icon from './Icon.astro';
import { byDate } from '../data/content';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort(byDate);
---

<Divider id="notes" n={4} title="Notes">
  Write-ups from the work: pipeline patterns, release practice and AI agent platforms.
</Divider>

<section class="sheet" aria-label="Latest notes">
  <div class="wrap">
    <div class="sheet-head">
      <h3><span class="num">4.1–4.{Math.min(posts.length, 3)}</span> Latest</h3>
      <a class="link-arrow" href="/blog">All notes <Icon name="arrow" /></a>
    </div>
    <PostList posts={posts.slice(0, 3)} />
  </div>
</section>
