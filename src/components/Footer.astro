---
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap row">
    <p><b>Nathan Tran</b> · Senior Platform Engineer &amp; Release Manager · Ho Chi Minh City</p>
    <p class="num">© {year}</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 2px solid var(--ink);
    font-size: 0.875rem;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 18px 22px;
  }

  p {
    color: var(--mute);
  }

  b {
    color: var(--ink);
  }
</style>
