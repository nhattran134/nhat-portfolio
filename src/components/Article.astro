---
// Body of a post or project page: a margin column of specs beside the prose.
interface Props {
  specs: [string, string | string[]][];
}
const { specs } = Astro.props;
---

<div class="wrap article">
  <aside aria-label="Details">
    <dl>
      {specs.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{Array.isArray(v) ? <ul class="tags">{v.map((t) => <li>{t}</li>)}</ul> : v}</dd>
        </div>
      ))}
    </dl>
    <slot name="aside" />
  </aside>
  <div class="prose">
    <slot />
  </div>
</div>

<style>
  .article {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 32px 40px;
    padding-block: 40px 88px;
    align-items: start;
  }

  aside {
    position: sticky;
    top: calc(var(--head-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  dl {
    border-top: 2px solid var(--ink);
  }

  dl > div {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
  }

  dd {
    margin-top: 2px;
    font-weight: 600;
  }

  dd .tags {
    color: var(--ink);
    font-size: 15px;
  }

  .prose > :global(:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  @media (max-width: 800px) {
    .article {
      grid-template-columns: minmax(0, 1fr);
    }
    aside {
      position: static;
    }
  }
</style>
