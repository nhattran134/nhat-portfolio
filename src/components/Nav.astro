---
// Running header: the manual's running head. Script marks the section in view.
const path = Astro.url.pathname;
const current = path === '/' ? 'services' : path.startsWith('/projects') ? 'work' : path.startsWith('/blog') ? 'notes' : '';
const sections = [
  { id: 'services', n: 1, label: 'Services' },
  { id: 'work', n: 2, label: 'Work' },
  { id: 'record', n: 3, label: 'Record' },
  { id: 'notes', n: 4, label: 'Notes' },
  { id: 'contact', n: 5, label: 'Contact' },
];
---

<header class="head">
  <div class="wrap head-row">
    <a class="who" href="/">
      <b>Nathan Tran</b>
      <span>Platform engineering, release management, AI agent platforms</span>
    </a>
    <nav aria-label="Sections">
      <ol>
        {sections.map((s) => (
          <li>
            <a href={`/#${s.id}`} data-nav={s.id} aria-current={s.id === current ? 'true' : undefined}>
              <span class="num">{s.n}</span>{s.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</header>

<style>
  .head {
    view-transition-name: site-head;
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }

  .head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--head-h);
  }

  .who {
    display: flex;
    align-items: baseline;
    gap: 24px;
    text-decoration: none;
    min-width: 0;
  }

  .who b {
    font-size: 1rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .who span {
    font-size: 0.875rem;
    color: var(--mute);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  ol {
    display: flex;
    gap: 22px;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    padding: 12px 0;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    position: relative;
  }

  nav a .num {
    color: var(--mute);
    font-weight: 500;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--field);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  nav a:hover,
  nav a[aria-current='true'] {
    color: var(--field);
  }

  nav a:hover .num,
  nav a[aria-current='true'] .num {
    color: var(--field);
  }

  nav a[aria-current='true']::after {
    transform: scaleX(1);
  }

  @media (max-width: 1100px) {
    .who span {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .head-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 10px;
    }
    nav {
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    ol {
      gap: 14px;
    }
    nav a {
      padding: 10px 0 12px;
      font-size: 0.875rem;
    }
  }

  /* Narrow phones: all five sections fit without clipping "Contact". */
  @media (max-width: 400px) {
    ol {
      gap: 10px;
    }
    nav a {
      font-size: 0.75rem;
      gap: 4px;
    }
  }
</style>
