---
import { getCollection } from 'astro:content';
import Divider from './Divider.astro';
import Flow from './Flow.astro';
import Icon from './Icon.astro';
import { byDate } from '../data/content';

const projects = (await getCollection('projects')).sort(byDate);
---

<Divider id="work" n={2} title="Work">
  Pipelines, cloud platforms and AI agent platforms built for enterprise teams. Client names left out.
</Divider>

<section class="sheet" aria-label="Projects">
  <div class="wrap">
    <div class="sheet-head">
      <h3><span class="num">2.1–2.{projects.length}</span> Projects</h3>
      <span>Newest first</span>
    </div>
    <ol class="projects">
      {projects.map((p, i) => (
        <li class:list={{ 'no-flow': !p.data.flow }}>
          <span class="n num">2.{i + 1}</span>
          <div class="body">
            <h3><a href={`/projects/${p.id}`}>{p.data.title}</a></h3>
            <p>{p.data.description}</p>
            <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
          {p.data.flow && <Flow steps={p.data.flow} label={`Figure 2.${i + 1} · Flow`} />}
          <a class="link-arrow more" href={`/projects/${p.id}`} aria-label={`Read ${p.data.title}`}>Read <Icon name="arrow" /></a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .projects {
    list-style: none;
  }

  .projects > li {
    display: grid;
    grid-template-columns: 52px minmax(0, 5fr) minmax(0, 6fr) auto;
    gap: 12px 28px;
    align-items: start;
    padding: 26px 0 28px;
    border-bottom: 1px solid var(--line);
  }

  .n {
    font-weight: 700;
    color: var(--field);
    padding-top: 6px;
  }

  .body h3 {
    font-size: 26px;
    font-weight: 800;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--field);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .body p {
    margin: 8px 0 12px;
    color: var(--mute);
    max-width: 56ch;
  }

  .more {
    grid-column: 4;
    padding-top: 8px;
  }

  .no-flow .body {
    grid-column: 2 / 4;
  }

  .no-flow .body p {
    max-width: 62ch;
  }

  @media (max-width: 1000px) {
    .projects > li {
      grid-template-columns: 52px minmax(0, 1fr);
    }
    .projects > li > :global(*:nth-child(n + 3)) {
      grid-column: 2;
    }
  }

  @media (max-width: 560px) {
    .projects > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .projects > li > :global(*) {
      grid-column: 1 !important;
    }
  }
</style>
