---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../data/content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  level?: 3 | 4; // heading level under the surrounding section heading
}
const { posts, level = 4 } = Astro.props;
const H = `h${level}` as 'h3' | 'h4';
---

<ol class="posts">
  {posts.map((post, i) => (
    <li>
      <span class="n num">4.{i + 1}</span>
      <time class="num" datetime={post.data.date}>{formatDate(post.data.date)}</time>
      <div>
        <H class="title"><a href={`/blog/${post.id}`}>{post.data.title}</a></H>
        <p>{post.data.excerpt}</p>
        <ul class="tags">{post.data.tags.map((t) => <li>{t}</li>)}</ul>
      </div>
    </li>
  ))}
</ol>

<style>
  .posts {
    list-style: none;
  }

  .posts > li {
    display: grid;
    grid-template-columns: 52px 130px minmax(0, 1fr);
    gap: 8px 28px;
    padding: 24px 0 26px;
    border-bottom: 1px solid var(--line);
  }

  .n {
    font-weight: 700;
    color: var(--field);
    padding-top: 4px;
  }

  time {
    font-weight: 600;
    color: var(--mute);
    padding-top: 4px;
  }

  .title {
    font-size: 1.5rem;
    font-weight: 800;
    max-width: 30ch;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    color: var(--field);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  p {
    margin: 8px 0 12px;
    color: var(--mute);
    max-width: 62ch;
  }

  @media (max-width: 700px) {
    .posts > li {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .posts > li > div {
      grid-column: 1 / -1;
    }
  }
</style>
