---
interface Props {
  id: string;
  n: number;
  title: string;
}
const { id, n, title } = Astro.props;
---

<section id={id} class="on-field divider" data-sec={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <h2 id={`${id}-title`}><span class="num">{n}</span> {title}</h2>
    <p><slot /></p>
  </div>
</section>
