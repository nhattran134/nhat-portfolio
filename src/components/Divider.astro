---
interface Props {
  id: string;
  n: number;
  title: string;
}
const { id, n, title } = Astro.props;
---

<section id={id} class="on-field divider" data-sec={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="numeral rise num" aria-hidden="true">{n}</div>
    <div>
      <h2 id={`${id}-title`}>{title}</h2>
      <p><slot /></p>
    </div>
  </div>
</section>
