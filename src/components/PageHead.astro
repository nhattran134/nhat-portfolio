---
// Cobalt header band for inner pages: section number, title, and a back link.
import Icon from './Icon.astro';

interface Props {
  n: string;
  title: string;
  back: { href: string; label: string };
}
const { n, title, back } = Astro.props;
---

<header class="on-field page-head">
  <div class="wrap grid">
    <a class="back" href={back.href}><Icon name="back" /> {back.label}</a>
    <div class="titles">
      <h1><span class="num">{n}</span> {title}</h1>
      <slot />
    </div>
  </div>
</header>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 20px 40px;
    padding-block: 22px 40px;
    align-items: end;
  }

  .back {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    color: var(--on-field-mute);
    padding: 6px 0;
  }

  .back:hover {
    color: var(--on-field);
  }

  .back :global(svg) {
    width: 16px;
    height: 16px;
  }

  .titles {
    grid-column: 2;
  }

  h1 {
    font-size: clamp(36px, 4.4vw, 64px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    max-width: 20ch;
  }

  .titles :global(p) {
    margin-top: 14px;
    font-size: 19px;
    line-height: 1.45;
    max-width: 52ch;
    color: var(--on-field-mute);
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .titles {
      grid-column: 1;
    }
  }
</style>
