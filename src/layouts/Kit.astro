---
// One layout for every page, built on the taste-skill kit copied into public/assets.
interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  title = 'Nhat Tran: CI/CD and release engineering in Ho Chi Minh City',
  description = 'Platform engineer and release manager who builds GitHub Actions, Terraform and Kubernetes pipelines for enterprise teams on AWS, Azure and Google Cloud.',
  home = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const shareURL = new URL('/share.jpg', Astro.site);
// on sub-pages the section anchors live on the home page
const to = (id: string) => (home ? `#${id}` : `/#${id}`);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-type="service" data-radius="soft" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonicalURL}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={shareURL}>
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href={canonicalURL}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#dfdedb">
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400..700&family=Libre+Franklin:wght@400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style is:inline>
:root {
  --p-bg: #dfdedb; --p-surface: #d3d2ce; --p-ink: #26251e; --p-muted: #5a5850;
  --p-accent: #2456d6; --p-accent-ink: #ffffff; --p-action: #2456d6; --p-action-ink: #ffffff;
  --p-inv-bg: #26251e; --p-inv-surface: #313029; --p-inv-ink: #dfdedb; --p-inv-muted: #9e9d99;
  --p-inv-accent: #dfdedb; --p-inv-accent-ink: #26251e; --p-inv-action: #dfdedb; --p-inv-action-ink: #26251e;
  --font-display: "Source Serif 4", Georgia, serif;
  --font-text: "Libre Franklin", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.02em;
  --display-tracking-xl: -0.026em;
}
</style>
<slot name="head" />
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
</head>
<body>
<!-- type: service (a platform engineer people hire)
     deal: hero split, nav nav-split (re-dealt: no panel, no photographs), close close-word head row without the name
     (re-dealt from close-photo: no photograph), footer footer-dark (re-dealt from footer-visit: no door to visit),
     rhythm surface-pairs (#experience), buttons arrow, mark stack, palette stone-blueprint, type source-serif
     moments: pinned-chapters in #releases (the release walks through three steps), word-highlight in #approach
     (the one statement about monorepo pipelines) -->
<header class="nav nav--split">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item"><a class="nav__link" href={to('services')}>Services</a></div>
      <div class="nav__item"><a class="nav__link" href={to('releases')}>Releases</a></div>
      <div class="nav__item"><a class="nav__link" href={to('work')}>Work</a></div>
      <div class="nav__item"><a class="nav__link" href={to('experience')}>Experience</a></div>
    </nav>
    <a class="nav__logo" href={home ? '#top' : '/'}><span class="mark" data-mark="stack" aria-hidden="true"></span>Nhat Tran</a>
    <div class="nav__actions">
      <a class="btn btn--primary" href={to('brief')}>Contact Nhat</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer class="footer closing footer--dark ground-inverse g2m" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--word">
      <div class="section-head--split">
        <div><h2 id="close-h">Work with Nhat on your releases</h2><p class="t-lead">Consulting, contract or full-time, from Ho Chi Minh City.</p></div>
        <a class="btn btn--primary" href={to('brief')}>Contact Nhat<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
      </div>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href={home ? '#top' : '/'}><span class="mark" data-mark="stack" aria-hidden="true"></span>Nhat Tran</a>
          <p class="footer__lede">Platform engineering and release management for teams on AWS, Azure and Google Cloud.</p>
        </div>
        <div class="span-2 footer__col"><h3>Services</h3><ul><li><a href={to('services')}>What I build</a></li><li><a href={to('releases')}>Release steps</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Work</h3><ul><li><a href={to('work')}>Pipeline projects</a></li><li><a href={to('approach')}>Approach</a></li></ul></div>
        <div class="span-2 footer__col"><h3>About</h3><ul><li><a href={to('experience')}>Experience</a></li><li><a href={to('brief')}>Send a message</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Writing</h3><ul><li><a href="/blog">Blog</a></li></ul></div>
      </div>
      <div class="footer__legal">
        <span>&copy; {year} Nhat Tran. Product names and logos are trademarks of their owners.</span>
        <div class="socials">
          <a href="https://linkedin.com/in/nathantr" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><img src="/assets/icons/linkedin.svg" alt="" width="20" height="20"></a>
          <a href="https://github.com/nhattran134" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><img class="ic-ink" src="/assets/icons/github.svg" alt="" width="20" height="20"></a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script type="module" is:inline src="/assets/system.js"></script>
<script type="module" is:inline src="/assets/motion/motion.js"></script>
<script type="module" is:inline src="/assets/layout/layout.js"></script>
<slot name="scripts" />
<script is:inline>
  // the widget loads deferred, so wait for it before wiring the CMS login redirect
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.netlifyIdentity) return;
    window.netlifyIdentity.on('init', function (user) {
      if (!user) window.netlifyIdentity.on('login', function () { document.location.href = '/admin/'; });
    });
  });
</script>
</body>
</html>
