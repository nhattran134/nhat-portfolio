---
// One layout for every page, built on the taste-skill kit copied into public/assets.
interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  title = 'Nathan Tran: CI/CD and release engineering in Ho Chi Minh City',
  description = 'Platform engineer and release manager who builds GitHub Actions, Terraform and Kubernetes pipelines for enterprise teams on AWS, Azure and Google Cloud.',
  home = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const shareURL = new URL('/share.jpg', Astro.site);
// on sub-pages the section anchors live on the home page
const to = (id: string) => (home ? `#${id}` : `/#${id}`);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-type="software" data-radius="sharp" data-ground="sky" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonicalURL}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={shareURL}>
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href={canonicalURL}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#161c1a">
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<link rel="stylesheet" href="/assets/ui/base.css">
<link rel="stylesheet" href="/assets/ui/code/fragment.css">
<style is:inline>
:root {
  --p-bg: #161c1a; --p-surface: #1f2725; --p-ink: #e3e2da; --p-muted: #8e948d;
  --p-accent: #9fc7b8; --p-accent-ink: #161c1a; --p-action: #9fc7b8; --p-action-ink: #161c1a;
  --p-inv-bg: #e3e2da; --p-inv-surface: #d3d2cb; --p-inv-ink: #161c1a; --p-inv-muted: #555a55;
  --p-inv-accent: #161c1a; --p-inv-accent-ink: #e3e2da; --p-inv-action: #161c1a; --p-inv-action-ink: #e3e2da;
  --font-display: "Geist", system-ui, sans-serif;
  --font-text: "Geist", system-ui, sans-serif;
  --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --display-weight: 500;
  --display-tracking: -0.035em;
  --display-tracking-xl: -0.045em;
}
/* under 360px the name, the main button and the menu need the mark's room in the bar */
@media (max-width: 359px) { .nav__bar .nav__logo .mark { display: none; } }
</style>
<slot name="head" />
<script is:inline src="/assets/backgrounds/backgrounds.js"></script>
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
</head>
<body>
<!-- type: software (a platform engineer whose subject is developer tooling and AI agent platforms)
     deal: hero triptych, nav nav-mega (re-dealt: nav-split is not on the software list), close close-word head row
     without the name, footer footer-dark, rhythm surface-pairs (#experience), buttons arrow, mark stack,
     palette green-black-bone, type geist, radius sharp, lit ground sky
     effect: painterly-landscape behind the hero collage (the one [data-visual])
     moments: pinned-chapters in #releases (the release walks through three steps), word-highlight in #approach
     (the one statement about monorepo pipelines); loops: one per card group (#work, #agents) -->
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href={home ? '#top' : '/'}><span class="mark" data-mark="stack" aria-hidden="true"></span>Nathan Tran</a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item"><a class="nav__link" href={to('services')}>Services</a></div>
      <div class="nav__item"><a class="nav__link" href={to('releases')}>Releases</a></div>
      <div class="nav__item">
        <a class="nav__link" href={to('work')}>Work <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-3">
              <p class="t-label">Pipelines</p>
              <a href="/projects/bdo-crm-pipeline">Monorepo CI/CD<span>.NET, a version per component</span></a>
              <a href="/projects/terraform-blueprint">Terraform pipeline<span>AWS, Azure and Google Cloud</span></a>
              <a href="/projects/java-maven-pipeline">Java services<span>Maven to Kubernetes with Helm</span></a>
              <a href="/projects/aws-landing-zone">AWS landing zone<span>Accounts, guardrails, FinOps</span></a>
            </div>
            <div class="menu-col span-3">
              <p class="t-label">AI agents</p>
              <a href="/projects/governed-ai-agent-platform">Governed agent platform<span>Amazon EKS, 18 MCP tools</span></a>
              <a href="/projects/agent-platform-blueprint">Agent platform blueprint<span>Coding, user and ops agents</span></a>
            </div>
            <a class="menu-card span-3 start-10" href="/projects/governed-ai-agent-platform">
              <div class="panel"><div class="stage stage--fade-br"><div class="at-corner" style="--ax:24px;--ay:24px" data-ui-still>
                <div class="ui ui-panel ui-code" data-ui="code">
                  <div class="ui-code__tabs"><span class="ui-code__tab is-on"><i class="ui-code__lang">YML</i>tools.yaml</span></div>
                  <pre class="ui-code__pre"><code><span class="ui-code__ln" data-n="1"><span class="f">billing.read:</span></span>
<span class="ui-code__ln is-mark" data-n="2">  <span class="f">jwt:</span> entra-id</span>
<span class="ui-code__ln" data-n="3">  <span class="f">role:</span> billing.viewer</span></code></pre>
                </div>
              </div></div></div>
              <span class="t-card">New: governed agents</span>
              <span class="t-small muted">Identity checked at the gateway</span>
            </a>
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href={to('experience')}>Experience</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={to('brief')}>Send a brief</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer class="footer closing footer--dark ground-inverse g2m" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--word">
      <div class="section-head--split">
        <div><h2 id="close-h">Work with Nathan on your releases</h2><p class="t-lead">Consulting, contract or full-time, from Ho Chi Minh City.</p></div>
        <a class="btn btn--primary" href={to('brief')}>Send a brief<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
      </div>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href={home ? '#top' : '/'}><span class="mark" data-mark="stack" aria-hidden="true"></span>Nathan Tran</a>
          <p class="footer__lede">Platform engineering and release management for teams on AWS, Azure and Google Cloud.</p>
        </div>
        <div class="span-2 footer__col"><h3>Services</h3><ul><li><a href={to('services')}>What I build</a></li><li><a href={to('releases')}>Release steps</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Work</h3><ul><li><a href={to('work')}>Pipeline projects</a></li><li><a href={to('agents')}>AI agent platforms</a></li><li><a href={to('approach')}>Approach</a></li></ul></div>
        <div class="span-2 footer__col"><h3>About</h3><ul><li><a href={to('experience')}>Experience</a></li><li><a href={to('brief')}>Send a message</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Writing</h3><ul><li><a href="/blog">Blog</a></li></ul></div>
      </div>
      <div class="footer__legal">
        <span>&copy; {year} Nathan Tran. Product names and logos are trademarks of their owners.</span>
        <div class="socials">
          <a href="https://linkedin.com/in/nathantr" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><img loading="lazy" decoding="async" src="/assets/icons/linkedin.svg" alt="" width="20" height="20"></a>
          <a href="https://github.com/nhattran134" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><img loading="lazy" decoding="async" class="ic-ink" src="/assets/icons/github.svg" alt="" width="20" height="20"></a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script type="module" is:inline src="/assets/system.js"></script>
<script type="module" is:inline src="/assets/motion/motion.js"></script>
<script type="module" is:inline src="/assets/layout/layout.js"></script>
<slot name="scripts" />
<script is:inline>
  // the widget loads deferred, so wait for it before wiring the CMS login redirect
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.netlifyIdentity) return;
    window.netlifyIdentity.on('init', function (user) {
      if (!user) window.netlifyIdentity.on('login', function () { document.location.href = '/admin/'; });
    });
  });
</script>
</body>
</html>
